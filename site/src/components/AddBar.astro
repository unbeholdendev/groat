---
import { byRecent } from "../../../shared/amount";
import { defaultCategories } from "../../../shared/categories";

const total = 1284.6;
const words: Record<string, string> = {
  Groceries: "groceries|tesco|lidl|sainsbury's|market|milk|bread",
  "Eating out": "ramen|pizza|thai|dim|lunch|dinner|coffee|sushi|curry",
  Fuel: "fuel|petrol|diesel",
  "Public transport": "tube|train|bus",
  Taxi: "taxi|uber",
  "Rent/Mortgage": "rent|mortgage",
  Utilities: "electricity|gas|water|phone|internet",
  Maintenance: "plumber|repair|paint",
  Subscriptions: "spotify|netflix",
  Health: "pharmacy|dentist|gym",
  Shopping: "clothes|shoes|amazon",
  Entertainment: "cinema|gig|bowling|concert",
  Travel: "flights|hotel",
  Gifts: "present|gift|flowers",
};
const recent = ["GBP", "EUR", "USD"];
const chevron = '<svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg>';
const palette = ["#f16f7e", "#f98942", "#f4bf3f", "#3fbe90", "#26c0cf", "#bf73df"];
const today = 18;
const days = Array.from({ length: 30 }, (_, d) =>
  d > 18
    ? []
    : [0, 1, 2]
        .slice(0, 1 + ((d * 5) % 3))
        .map((k) => ({ c: palette[(d * 5 + k * 2) % 6], h: 3 + ((d * 11 + k * 7) % 17) })),
);
---

<div class="demo" data-demo>
  <p class="demo-tag">Interactive demo · Nothing is saved</p>
  <p class="total-label">Spent this month</p>
  <p class="total" data-total={total}>
    <span class="sr">£1,284.60 spent this month</span>
    <span aria-hidden="true" data-count>£1,284<span class="pence">.60</span></span>
  </p>
  <div class="skyline" aria-hidden="true">
    {
      days.map((segs, d) => (
        <span class={segs.length ? "day" : "day empty"} data-today={d === today ? "" : undefined}>
          {segs.map((s) => (
            <i style={`--c:${s.c};--h:${s.h}`} />
          ))}
        </span>
      ))
    }
  </div>
  <form class="bar" data-form>
    <div class="mirror" aria-hidden="true" data-mirror></div>
    <input
      data-line
      aria-label="Try the add bar: a note, an amount and #tags, or ? and a question"
      aria-describedby="demo-note"
      placeholder="ramen 24.50, or ? to ask"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
    />
  </form>
  <div class="answer" data-answer hidden>
    <p class="question" data-question></p>
    <p data-reply></p>
  </div>
  <div class="chips">
    <label class="chip pick" data-category-chip>
      <span class="tile" data-tile hidden></span><span data-category-label>Category</span><Fragment set:html={chevron} />
      <select aria-label="Category" data-category>
        <option value="">Category</option>
        {
          defaultCategories.flatMap(([name, emoji, colour, children = []]) => {
            const option = (n: string, e: string, indent = "") => (
              <option value={n} data-emoji={e} data-colour={colour} data-words={words[n]}>
                {`${indent}${e} ${n}`}
              </option>
            );
            return [option(name, emoji), ...children.map(([n, e]) => option(n, e, "   "))];
          })
        }
      </select>
    </label>
    <label class="chip pick">
      <span data-date-label>Today</span><Fragment set:html={chevron} />
      <input type="date" aria-label="Date" data-date />
    </label>
    <label class="chip pick">
      <span data-currency-label>GBP</span><Fragment set:html={chevron} />
      <select aria-label="Currency" data-currency>{byRecent(recent).map((c) => <option>{c}</option>)}</select>
    </label>
  </div>
  <p class="demo-note" id="demo-note" aria-live="polite" data-note>Tap the bar and try your own line.</p>
</div>

<script>
  import { dayLabel, today } from "../../../shared/dates";
  import { parse } from "../../../shared/parse";

  const recent = ["GBP", "EUR", "USD"];

  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const input = demo.querySelector("[data-line]") as HTMLInputElement;
    const mirror = demo.querySelector("[data-mirror]") as HTMLElement;
    const category = demo.querySelector("[data-category]") as HTMLSelectElement;
    const categoryChip = demo.querySelector("[data-category-chip]") as HTMLElement;
    const categoryLabel = demo.querySelector("[data-category-label]") as HTMLElement;
    const tile = demo.querySelector("[data-tile]") as HTMLElement;
    const date = demo.querySelector("[data-date]") as HTMLInputElement;
    const dateLabel = demo.querySelector("[data-date-label]") as HTMLElement;
    const currency = demo.querySelector("[data-currency]") as HTMLSelectElement;
    const currencyLabel = demo.querySelector("[data-currency-label]") as HTMLElement;
    const form = demo.querySelector("[data-form]") as HTMLFormElement;
    const todayBar = demo.querySelector("[data-today]") as HTMLElement;
    const answer = demo.querySelector("[data-answer]") as HTMLElement;
    const question = demo.querySelector("[data-question]") as HTMLElement;
    const reply = demo.querySelector("[data-reply]") as HTMLElement;
    const note = demo.querySelector("[data-note]") as HTMLElement;
    let picked = false;

    const showCategory = () => {
      const o = category.selectedOptions[0];
      const set = !!category.value;
      categoryChip.classList.toggle("set", set);
      tile.hidden = !set;
      tile.textContent = o.dataset.emoji ?? "";
      tile.style.setProperty("--c", o.dataset.colour ?? "");
      categoryLabel.textContent = o.value || "Category";
    };
    const count = demo.querySelector("[data-count]") as HTMLElement;
    const totalEl = demo.querySelector("[data-total]") as HTMLElement;

    const token = (text: string, kind = "") => {
      const span = document.createElement("span");
      span.textContent = text;
      if (kind) span.className = `tok-${kind}`;
      return span;
    };

    const render = () => {
      const asking = input.value.startsWith("?");
      demo.toggleAttribute("data-asking", asking);
      if (!asking) answer.hidden = true;
      if (asking) {
        mirror.replaceChildren(token("?", "ask"), token(input.value.slice(1)));
        mirror.scrollLeft = input.scrollLeft;
        return;
      }
      const p = parse(input.value, recent);
      mirror.replaceChildren(...p.parts.map(([w, kind]) => token(w, kind)));
      mirror.scrollLeft = input.scrollLeft;
      if (p.currency) {
        currency.value = p.currency;
        currencyLabel.textContent = p.currency;
      }
      if (picked) return;
      const first = p.note.split(" ")[0]?.toLowerCase() ?? "";
      const hit = [...category.options].find((o) => o.dataset.words && new RegExp(`^(${o.dataset.words})$`).test(first));
      category.value = hit?.value ?? "";
      showCategory();
    };

    const format = (n: number) => {
      const [whole, pence] = n.toFixed(2).split(".");
      count.replaceChildren(`£${Number(whole).toLocaleString("en-GB")}`);
      const small = document.createElement("span");
      small.className = "pence";
      small.textContent = `.${pence}`;
      count.append(small);
    };

    let shown = Number(totalEl.dataset.total);
    let total = shown;
    let counting = 0;
    const countTo = (to: number, ms: number) => {
      cancelAnimationFrame(counting);
      const from = shown;
      const start = performance.now();
      const step = (now: number) => {
        const t = still.matches ? 1 : Math.min(1, (now - start) / ms);
        shown = from + (to - from) * (1 - (1 - t) ** 4);
        format(shown);
        if (t < 1) counting = requestAnimationFrame(step);
      };
      counting = requestAnimationFrame(step);
    };

    const rates: Record<string, number> = { GBP: 1, EUR: 0.86, USD: 0.76 };
    const pounds = (n: number) => `£${n.toLocaleString("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const start = { eatingOut: 187.8, meals: 11 };
    let { eatingOut, meals } = start;

    const add = () => {
      const p = parse(input.value, recent);
      const amount = Number(p.amount);
      const rate = rates[p.currency ?? currency.value];
      if (!p.amount || !(amount > 0)) return (note.textContent = "Add an amount, like 24.50.");
      if (!rate) return (note.textContent = "This demo only converts GBP, EUR and USD.");
      const value = amount * rate;
      const chosen = category.selectedOptions[0];
      if (category.value === "Eating out") {
        eatingOut += value;
        meals++;
      }
      const seg = document.createElement("i");
      seg.className = auto ? "new auto" : "new";
      seg.style.setProperty("--c", chosen.dataset.colour || "var(--accent)");
      seg.style.setProperty("--h", String(Math.min(24, Math.max(3, Math.round(value / 3)))));
      todayBar.append(seg);
      total += value;
      countTo(total, 700);
      note.textContent = `Added ${p.note || "an expense"} · ${pounds(value)}`;
      input.value = "";
      picked = false;
      render();
    };

    const ask = () => {
      const q = input.value.slice(1).trim();
      if (!q) return (note.textContent = "Type a question after the ?.");
      question.textContent = q;
      reply.textContent = /eat|food|restaurant|lunch|dinner|meal/i.test(q)
        ? `${pounds(eatingOut)} on eating out this month, across ${meals} expenses.`
        : "This demo only knows about eating out. On your server, the answer comes from your ledger.";
      input.value = "";
      render();
      answer.hidden = false;
      note.textContent = "Asking needs AI. Answers come from your own data.";
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (input.value.startsWith("?")) ask();
      else add();
    });

    let typing = 0;
    let auto = true;
    const stopTyping = () => {
      if (!auto) return;
      auto = false;
      clearTimeout(typing);
      demo.removeAttribute("data-idle");
      note.setAttribute("aria-live", "polite");
      note.textContent = "Tap the bar and try your own line.";
      input.value = "";
      render();
    };
    const wait = (ms: number) => new Promise((done) => (typing = window.setTimeout(done, ms)));
    const type = async (text: string) => {
      for (let i = 0; i <= text.length && auto; i++) {
        input.value = text.slice(0, i);
        render();
        await wait(i === 0 ? 500 : 70);
      }
      await wait(900);
      if (auto) form.requestSubmit();
    };

    input.addEventListener("input", render);
    category.addEventListener("change", () => ((picked = true), showCategory()));
    date.max = date.value = today();
    date.addEventListener("click", () => date.showPicker?.());
    date.addEventListener("change", () => {
      date.value ||= today();
      dateLabel.textContent = dayLabel(date.value);
    });
    currency.addEventListener("change", () => {
      const { parts } = parse(input.value, recent);
      input.value = parts.map(([w, kind]) => (kind === "currency" ? currency.value : w)).join("");
      currencyLabel.textContent = currency.value;
      render();
    });
    input.addEventListener("scroll", () => (mirror.scrollLeft = input.scrollLeft));
    input.addEventListener("pointerdown", stopTyping);
    input.addEventListener("focus", stopTyping);

    if (still.matches) {
      auto = false;
      input.value = "ramen 24.50 #friends";
      render();
      continue;
    }
    shown = 0;
    format(0);
    countTo(total, 1400);
    note.setAttribute("aria-live", "off");
    const base = total;
    const examples = ["ramen 24.50 #friends", "14.80 taxi home", "coffee 3.20 EUR", "? how much on eating out"];
    const reset = () => {
      for (const seg of todayBar.querySelectorAll(".auto")) seg.remove();
      ({ eatingOut, meals } = start);
      currency.value = currencyLabel.textContent = "GBP";
      total = base;
      countTo(total, 700);
    };
    void (async () => {
      for (let i = 0; auto; i = (i + 1) % examples.length) {
        if (i === 0 && todayBar.querySelector(".auto")) reset();
        await type(examples[i]);
        demo.toggleAttribute("data-idle", auto);
        await wait(2600);
        demo.removeAttribute("data-idle");
      }
    })();
  }
</script>
