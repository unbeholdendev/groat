---
import { defaultCategories } from "../../../shared/categories";

const total = 1284.6;
const words: Record<string, string> = {
  Groceries: "groceries|tesco|lidl|sainsbury's|market|milk|bread",
  "Eating out": "ramen|pizza|thai|dim|lunch|dinner|coffee|sushi|curry",
  Fuel: "fuel|petrol|diesel",
  "Public transport": "tube|train|bus",
  Taxi: "taxi|uber",
  "Rent/Mortgage": "rent|mortgage",
  Utilities: "electricity|gas|water|phone|internet",
  Maintenance: "plumber|repair|paint",
  Subscriptions: "spotify|netflix",
  Health: "pharmacy|dentist|gym",
  Shopping: "clothes|shoes|amazon",
  Entertainment: "cinema|gig|bowling|concert",
  Travel: "flights|hotel",
  Gifts: "present|gift|flowers",
};
const dates = ["Today", "Yesterday", "2 days ago", "3 days ago", "Last week"];
const currencies = ["GBP", "EUR", "USD", "BTC"];
const chevron = '<svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg>';
const palette = ["#f16f7e", "#f98942", "#f4bf3f", "#3fbe90", "#26c0cf", "#bf73df"];
const days = Array.from({ length: 30 }, (_, d) =>
  d > 18
    ? []
    : [0, 1, 2]
        .slice(0, 1 + ((d * 5) % 3))
        .map((k) => ({ c: palette[(d * 5 + k * 2) % 6], h: 3 + ((d * 11 + k * 7) % 17) })),
);
---

<div class="demo" data-demo>
  <p class="total" data-total={total}>
    <span class="sr">£1,284.60</span>
    <span aria-hidden="true" data-count>£1,284<span class="pence">.60</span></span>
  </p>
  <div class="skyline" aria-hidden="true">
    {
      days.map((segs) => (
        <span class={segs.length ? "day" : "day empty"}>
          {segs.map((s) => (
            <i style={`--c:${s.c};--h:${s.h}`} />
          ))}
        </span>
      ))
    }
  </div>
  <div class="bar">
    <div class="mirror" aria-hidden="true" data-mirror></div>
    <input
      data-line
      aria-label="Try the add bar: a note, an amount and #tags"
      aria-describedby="demo-note"
      placeholder="ramen 24.50 #friends"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="done"
    />
  </div>
  <div class="chips">
    <label class="chip pick" data-category-chip>
      <span class="tile" data-tile hidden></span><span data-category-label>Category</span><Fragment set:html={chevron} />
      <select aria-label="Category" data-category>
        <option value="">Category</option>
        {
          defaultCategories.map(([name, emoji, colour, children]) => {
            const option = (n: string, e: string) => (
              <option value={n} data-emoji={e} data-colour={colour} data-words={words[n]}>
                {n}
              </option>
            );
            return children ? (
              <optgroup label={name}>{children.map(([n, e]) => option(n, e))}</optgroup>
            ) : (
              option(name, emoji)
            );
          })
        }
      </select>
    </label>
    <label class="chip pick">
      <span data-date-label>Today</span><Fragment set:html={chevron} />
      <select aria-label="Date" data-date>{dates.map((d) => <option>{d}</option>)}</select>
    </label>
    <label class="chip pick">
      <span data-currency-label>GBP</span><Fragment set:html={chevron} />
      <select aria-label="Currency" data-currency>{currencies.map((c) => <option>{c}</option>)}</select>
    </label>
  </div>
  <p class="demo-note" id="demo-note">Try your own line. This is a demo; nothing is saved.</p>
</div>

<script>
  import { parse } from "../../../shared/parse";

  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const input = demo.querySelector("[data-line]") as HTMLInputElement;
    const mirror = demo.querySelector("[data-mirror]") as HTMLElement;
    const category = demo.querySelector("[data-category]") as HTMLSelectElement;
    const categoryChip = demo.querySelector("[data-category-chip]") as HTMLElement;
    const categoryLabel = demo.querySelector("[data-category-label]") as HTMLElement;
    const tile = demo.querySelector("[data-tile]") as HTMLElement;
    const date = demo.querySelector("[data-date]") as HTMLSelectElement;
    const currency = demo.querySelector("[data-currency]") as HTMLSelectElement;
    const currencyLabel = demo.querySelector("[data-currency-label]") as HTMLElement;
    let picked = false;

    const showCategory = () => {
      const o = category.selectedOptions[0];
      const set = !!category.value;
      categoryChip.classList.toggle("set", set);
      tile.hidden = !set;
      tile.textContent = o.dataset.emoji ?? "";
      tile.style.setProperty("--c", o.dataset.colour ?? "");
      categoryLabel.textContent = o.textContent?.trim() ?? "";
    };
    const count = demo.querySelector("[data-count]") as HTMLElement;
    const totalEl = demo.querySelector("[data-total]") as HTMLElement;

    const render = () => {
      const p = parse(input.value, ["GBP", "EUR", "USD"]);
      mirror.replaceChildren(
        ...p.parts.map(([w, kind]) => {
          const span = document.createElement("span");
          span.textContent = w;
          if (kind) span.className = `tok-${kind}`;
          return span;
        }),
      );
      mirror.scrollLeft = input.scrollLeft;
      if (p.currency) {
        if (![...currency.options].some((o) => o.value === p.currency)) currency.add(new Option(p.currency));
        currency.value = p.currency;
        currencyLabel.textContent = p.currency;
      }
      if (picked) return;
      const first = p.note.split(" ")[0]?.toLowerCase() ?? "";
      const hit = [...category.options].find((o) => o.dataset.words && new RegExp(`^(${o.dataset.words})$`).test(first));
      category.value = hit?.value ?? "";
      showCategory();
    };

    const format = (n: number) => {
      const [whole, pence] = n.toFixed(2).split(".");
      count.replaceChildren(`£${Number(whole).toLocaleString("en-GB")}`);
      const small = document.createElement("span");
      small.className = "pence";
      small.textContent = `.${pence}`;
      count.append(small);
    };

    let typing = 0;
    const stopTyping = () => clearTimeout(typing);
    const type = (text: string, i = 0) => {
      input.value = text.slice(0, i);
      render();
      if (i < text.length) typing = window.setTimeout(() => type(text, i + 1), i === 0 ? 500 : 70);
    };

    input.addEventListener("input", render);
    category.addEventListener("change", () => ((picked = true), showCategory()));
    date.addEventListener("change", () => ((demo.querySelector("[data-date-label]") as HTMLElement).textContent = date.value));
    currency.addEventListener("change", () => {
      const { parts } = parse(input.value, ["GBP", "EUR", "USD"]);
      input.value = parts.map(([w, kind]) => (kind === "currency" ? currency.value : w)).join("");
      currencyLabel.textContent = currency.value;
      render();
    });
    input.addEventListener("scroll", () => (mirror.scrollLeft = input.scrollLeft));
    input.addEventListener("pointerdown", stopTyping);
    input.addEventListener("focus", stopTyping);

    const end = Number(totalEl.dataset.total);
    if (still.matches) {
      input.value = "ramen 24.50 #friends";
      render();
      continue;
    }
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 1400);
      format(end * (1 - (1 - t) ** 4));
      if (t < 1) requestAnimationFrame(step);
    };
    format(0);
    requestAnimationFrame(step);
    type("ramen 24.50 #friends");
  }
</script>
